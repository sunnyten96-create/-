+/* Mobile 0.7.0 · Web 9.6.12 — editorial memo readability */
+.editor-memo-hub{padding:0;overflow:hidden;border-color:color-mix(in srgb,var(--amber) 25%,var(--line));background:linear-gradient(180deg,color-mix(in srgb,var(--amber-soft) 24%,var(--surface)) 0,var(--surface) 150px)}
+.editor-memo-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:17px 16px 12px}.editor-memo-title{font-size:.92rem;font-weight:1000;letter-spacing:-.035em;margin-top:3px}.editor-memo-desc{font-size:.58rem;line-height:1.55;color:var(--muted);margin-top:4px;max-width:290px}.memo-total{min-width:50px;height:50px;border-radius:16px;display:flex;align-items:baseline;justify-content:center;gap:2px;background:var(--nav);color:#fff;font-size:1.1rem;font-weight:1000;padding-top:13px}.memo-total small{font-size:.5rem;opacity:.65}
+.memo-count-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;padding:0 16px 12px}.memo-count-strip span{display:flex;align-items:center;justify-content:center;gap:5px;padding:8px 5px;border-radius:11px;font-size:.53rem;font-weight:900;border:1px solid var(--hairline);background:var(--surface)}.memo-count-strip b{font-size:.68rem}.memo-count-strip .required{color:#bd2446;background:color-mix(in srgb,#ffe4e9 58%,var(--surface))}.memo-count-strip .refinement{color:#6d4bc2;background:color-mix(in srgb,#eee8ff 58%,var(--surface))}.memo-count-strip .legacy{color:#a55a13;background:color-mix(in srgb,#fff0df 58%,var(--surface))}
+.memo-warning{margin:0 16px 11px;padding:10px 11px;border-radius:12px;background:#fff7dc;border:1px solid #efd88a;color:#785a0b;font-size:.57rem;line-height:1.55}.memo-preserve{margin:0 16px 10px;border:1px solid color-mix(in srgb,#3fa56b 28%,var(--line));border-radius:13px;background:color-mix(in srgb,#e8f8ef 55%,var(--surface));overflow:hidden}.memo-preserve>summary{padding:10px 11px;font-size:.59rem;font-weight:950;color:#267548}.memo-preserve>summary b{float:right}.memo-preserve>div{border-top:1px solid color-mix(in srgb,#3fa56b 20%,var(--hairline));padding:4px 11px 9px}.preserve-row{padding:7px 0}.preserve-row p{font-size:.6rem;line-height:1.55;margin:0}
+.memo-filter-bar{display:flex;gap:6px;overflow:auto;padding:2px 16px 11px;scrollbar-width:none}.memo-filter-bar::-webkit-scrollbar{display:none}.memo-filter{flex:0 0 auto;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:999px;padding:7px 10px;font-size:.54rem;font-weight:950}.memo-filter b{margin-left:5px;font-size:.49rem;opacity:.65}.memo-filter.on{background:var(--nav);color:#fff;border-color:var(--nav)}.memo-filter.required.on{background:#c93658;border-color:#c93658}.memo-filter.refinement.on{background:#7658c9;border-color:#7658c9}.memo-filter.legacy.on{background:#c76d1d;border-color:#c76d1d}
+.memo-list{display:grid;gap:9px;padding:0 12px 14px}.memo-card{border:1px solid var(--line);border-radius:16px;background:var(--surface);overflow:hidden;box-shadow:0 3px 12px rgba(15,23,42,.035)}.memo-card.required{border-left:4px solid #d94c69}.memo-card.refinement{border-left:4px solid #8566d4}.memo-card.legacy{border-left:4px solid #d77c2b}.memo-card>summary{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:12px 12px 11px;cursor:pointer;list-style:none}.memo-card>summary::-webkit-details-marker{display:none}.memo-card-head{min-width:0;flex:1}.memo-card-badges{display:flex;align-items:center;gap:5px}.memo-kind,.memo-mini-badge{display:inline-flex;border-radius:7px;padding:3px 6px;font-size:.47rem;font-weight:1000}.memo-kind.required{background:#ffe8ed;color:#b92146}.memo-kind.refinement{background:#eee9ff;color:#6646bd}.memo-kind.legacy{background:#fff0df;color:#9f5611}.memo-mini-badge{background:var(--surface-2);color:var(--muted)}.memo-card-title{font-size:.72rem;line-height:1.45;font-weight:1000;letter-spacing:-.025em;margin-top:7px}.memo-card-preview{font-size:.58rem;line-height:1.55;color:var(--muted);margin-top:5px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.memo-card-meta{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}.memo-card-meta span{font-size:.47rem;color:var(--muted);background:var(--surface-2);border-radius:6px;padding:3px 5px}.memo-card>summary .detail-chevron{margin-top:3px;transition:transform .2s}.memo-card[open]>summary .detail-chevron{transform:rotate(180deg)}
+.memo-card-body{border-top:1px solid var(--hairline);padding:11px 12px 12px;display:grid;gap:9px}.memo-evidence-line{display:grid;gap:6px}.memo-evidence-line>b,.memo-axis-row>b{font-size:.49rem;color:var(--muted);font-weight:1000}.memo-axis-row{display:flex;flex-wrap:wrap;align-items:center;gap:5px}.memo-axis-row span{font-size:.49rem;padding:4px 6px;border-radius:7px;background:var(--surface-2);color:var(--muted);font-weight:850}.memo-block{padding:10px 11px;border-radius:12px;background:var(--surface-2);border:1px solid var(--hairline)}.memo-block>span{display:block;font-size:.49rem;color:var(--muted);font-weight:1000;margin-bottom:4px}.memo-block p{margin:0;font-size:.61rem;line-height:1.65;white-space:pre-line}.memo-block ol,.memo-block ul{margin:5px 0 0;padding-left:17px;font-size:.6rem;line-height:1.65}.memo-block.impact{background:color-mix(in srgb,var(--amber-soft) 45%,var(--surface));}.memo-block.strategy{background:color-mix(in srgb,var(--blue-soft) 38%,var(--surface));}.memo-block.preserve{background:color-mix(in srgb,#e7f7ee 55%,var(--surface));border-color:color-mix(in srgb,#54a776 25%,var(--hairline))}.memo-block.success{background:color-mix(in srgb,#e9f0ff 52%,var(--surface));border-color:color-mix(in srgb,#547fd4 22%,var(--hairline))}.memo-diff{display:grid;gap:7px}.revision-action-summary{border:1px solid var(--hairline);border-radius:12px;background:var(--surface-2);padding:10px}.revision-action-summary summary{font-size:.56rem;font-weight:900;color:var(--muted)}
+.editor-memo-hub .editorial-exclusion-panel{margin:0 12px 14px}.editor-memo-hub .editorial-point-actions{margin-top:2px}.editor-memo-hub .point-question{color:var(--blue)}
