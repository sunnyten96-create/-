 function revisionPanel(a){const memo=a.editorMemo,copy=arr(a.copyeditAudit).length?arr(a.copyeditAudit):arr(memo?.copyeditFindings),impact=a.copyeditImpact;const actions=arr(memo?.revisionActions);return `${impact?reportSection('교정 누적 영향','info',`<div class="impact-badge ${esc(impact.level)}">${esc(impact.level)}</div><div class="person-copy">${esc(impact.rationale||'')}</div><div class="evidence-row">${evidenceButtons(impact.evidenceIds,impact.rationale)}</div>`,'',true):''}${copy.length?reportSection('편집자 수정사항 메모','edit',copy.map((x,i)=>copyeditCard(x,i)).join(''),copy.length,true):empty('edit','수정 메모가 없습니다','현재 분석에서 검증된 문장 교정 항목이 없습니다.')}${actions.length?reportSection('수정 행동','check',actions.map((x,i)=>`<details class="action-card action-detail" ${i===0?'open':''}><summary>${esc(x.action||'수정 행동')}</summary>${x.reason?`<div class="person-copy">${esc(x.reason)}</div>`:''}${arr(x.evidence).length?`<div class="evidence-row">${evidenceButtons(x.evidence,x.action)}</div>`:''}</details>`).join(''),actions.length,true):''}${arr(a.suggestions).length?reportSection('상세 수정 제안','edit',a.suggestions.map((x,i)=>suggestionCard(x,i)).join(''),a.suggestions.length,true):''}`}
