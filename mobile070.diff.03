 function editorialExclusionPanel(){const rules=arr(state.editorialExclusions);if(!rules.length)return'';return `<details class="editorial-exclusion-panel"><summary>재제안 제외 ${rules.length}개 · 관리</summary><div class="editorial-exclusion-note">같은 회차의 수정본과 연결된 작품 사본에 적용됩니다. 평가 점수는 바뀌지 않습니다.</div>${rules.map(r=>`<div class="excluded-rule"><span>${esc(r?.suggestion?.issue||'제외한 편집점')}</span><button data-action="editorial-restore" data-rule="${esc(r.id)}">복원</button></div>`).join('')}</details>`}
