',oneLine=a.meetingOneLineReview||a.finalJudgement||a.editorialReports?.[0]?.finalAssessment?.oneLineVerdict||'';const axes=axisMap.map(([k,label])=>{const item=a.scores?.[k],v=num(item?.score);return `<div class="axis-row"><div class="axis-name">${esc(label)}</div><div class="axis-track"><div class="axis-fill" style="width:${axisPct(v)}%"></div></div><div class="axis-score">${state.scoreDisplay==='hidden'?'':evaluationValue(v,10)}<small>${evaluationUnit(10)}</small></div></div>`}).join('');const strengths=arr(memo?.preserveClaims).length?linkedClaims(memo.preserveClaims,false):listHtml(a.positives,false,'positive');const risks=arr(memo?.issueClaims).length?linkedClaims(memo.issueClaims,true):listHtml(a.negatives,true,'negative');return `<div class="section-head report-head"><div><div class="section-kicker">EDITORIAL REPORT · ${c.number}화</div><div class="section-title">${esc(c.title||`${c.number}화`)}</div><div class="section-desc">핵심 판단부터 읽고 필요한 세부 항목만 펼쳐보세요.</div></div><div class="report-head-actions"><button class="secondary-btn small-btn" data-action="revision-history">수정본 기록</button><button class="secondary-btn small-btn" data-action="close-report">목록</button></div></div><section class="card hero-score ${state.scoreDisplay==='hidden'?'score-hidden':''}"><div class="score-top"><div><span class="score-number">${state.scoreDisplay==='hidden'?'—':evaluationValue(q)}</span><span class="score-denom">${evaluationUnit()}</span><div><span class="score-band">${state.scoreDisplay==='hidden'?'평가 수치 미표기':evaluationLabel()}</span></div></div><div class="score-side"><div class="score-side-label">평가 안정성</div><div class="score-side-val">${esc(a.scoreConfidenceLabel||'-')}</div><div class="score-side-label secondary-label">신뢰도</div><div class="score-side-val">${score(a.scoreConfidence)}%</div></div></div>${oneLine?`<div class="score-summary">${esc(oneLine)}</div>`:''}</section><div class="report-stack">${reportHubSection('editor','편집자 의견','spark',`<div class="editorial-opinion-c