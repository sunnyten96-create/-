te.sheet;if(s?.type!=='revision-history')return;const k=decodeURIComponent(el.dataset.key||'');s.selected=s.selected.includes(k)?s.selected.filter(x=>x!==k):(s.selected.length>=2?[s.selected[0],k]:[...s.selected,k]);render();return}if(a==='revision-clear'){if(state.sheet?.type==='revision-history'){state.sheet.selected=[];render()}return}if(a==='revision-inspect'){await inspectRevision();return}if(a==='revision-back'){if(state.sheet?.type==='revision-detail'){state.sheet=state.sheet.returnTo;render()}return}if(a==='close-report'){state.projectTab='chapters';state.selectedChapter=null;state.analysis=null;state.editorialExclusions=[];state.directorFocus=null;render();return}if(a==='report-tab'){state.reportTab=id;render();return}if(a==='open-comments'){state.readerCommentLimit=16;const returnSheet=state.sheet?.type==='manuscript'?{...state.sheet}:null;state.sheet={type:'comments',returnSheet};render();return}if(a==='more-reader-comments'){state.readerCommentLimit=Math.min(999,state.readerCommentLimit+20);render();return}if(a==='analyze-one'){const c=state.chapters.find(x=>x.id===id)||state.selectedChapter;await analyzeChapter(c);return}if(a==='analyze-selected'){await analyzeSelected();return}if(a==='toggle-average'){await toggleAverage([...state.selectedChapterIds],val==='exclude');return}if(a==='toggle-one-average'){await toggleAverage([id],val==='exclude');state.sheet=null;return}if(a==='bulk-duplicate'){await bulkDuplicate();return}if(a==='bulk-delete'){await bulkDelete();return}if(a==='duplicate-chapter'){await duplicateChapter(id);state.sheet=null;return}if(a==='delete-chapter'){await deleteChapter(id);state.sheet=null;return}if(a==='reset-chapter'){await resetChapter(id);state.sheet=null;return}if(a==='character-toggle'){await excludeCharacter(el.dataset.name,val==='exclude');return}if(a==='edit-memory'){const item=arr(state.memory?.elements).find(x=>x.id===id);if(item){state.sheet={type:'memory-edit',element:item};render()}return}if(a==='memory-status'){await patchMemoryElement(id,val);return}if(a==='recommend-titles'){await recommendTitles();return}if(a==='duplicate-project'){await duplicateProject();return}if(a==='delete-project'){await deleteProject();return}if(a==='reset-project'){await resetProject();return}if(a==='trash'){await loadTrash();return}if(a==='restore-trash'){await restoreTrash(id);return}if(a==='purge-trash'){await purgeTrash(id);return}if(a==='empty-trash'){await emptyTrash();return}if(a==='cancel-job'){await cancelJob(id);return}if(a==='cancel-all'){await cancelAll();return}if(a==='notice-tab'){state.noticeTab=id;if(id==='announcements')await loadAnnouncements(false);render();return}if(a==='announcement'){await readAnnouncement(id);return}if(a==='theme'){state.theme=id;localStorage.setItem(LS.theme,id);applyAppearance();render();return}if(a==='score-display'){await saveDisplayPreference(id);return}if(a==='toggle-native'){state.nativeNotices=!state.nativeNotices;localStorage.setItem(LS.native,state.nativeNotices?'1':'0');if(state.nativeNotices)try{window.NovelNative?.requestNotifications?.()}catch(_){}setTimeout(()=>{refreshNativePermission();render()},450);render();return}if(a==='notification-settings'){try{window.NovelNative?.openAppSettings?.()}catch(_){}return}if(a==='remove-key'){await removeKey(id);return}if(a==='test-ai'){await testAI();return}if(a==='logout'){await logout();return}if(a==='external'){openExternal(path);return}if(a==='close-sheet'){if(state.sheet?.type==='comments'&&state.sheet.returnSheet)state.sheet=state.sheet.returnSheet;else state.sheet=null;render();return}if(a==='evidence'){if(state.selectedChapter?.id)await openManuscript(state.selectedChapter.id,id,el.dataset.claim||'');return}}
+async function handleAction(e){const el=e.currentTarget,a=el.dataset.action,id=el.dataset.id,val=el.dataset.value,path=el.dataset.path;if(a==='tab'){if(id==='director'){toggleDirector();return}state.directorOpen=false;state.tab=id;if(id==='queue'){state.queueRenderLimit=24;render();scrollTo(0,0);setTimeout(async()=>{const changed=await loadJobs(false);if(changed&&state.tab==='queue')updateQueueDom()},0);return}if(id==='notifications'){state.notices.forEach(n=>n.read=true);saveLocalNotices();render();scrollTo(0,0);setTimeout(async()=>{await loadAnnouncements(false);if(state.tab==='notifications')render()},0);return}if(id==='settings'){render();scrollTo(0,0);setTimeout(async()=>{await loadSettings(false);if(state.tab==='settings')render()},0);return}render();scrollTo(0,0);return}if(a==='director-close'){state.directorOpen=false;render();return}if(a==='director-clear'){directorClear();return}if(a==='director-mode'){state.directorMode=id;render();setTimeout(()=>document.getElementById('director-input')?.focus(),50);return}if(a==='director-prompt'){const input=document.getElementById('director-input');if(input){input.value=el.dataset.prompt||'';input.focus()}return}if(a==='director-send'){await directorSend();return}if(a==='director-cancel'){directorCancel();return}if(a==='director-proposal'){await executeDirectorProposal(el.dataset.mid,el.dataset.index);return}if(a==='director-ui-action'){await directorUiAction(el.dataset.mid,el.dataset.index);return}if(a==='back'){nativeBack();return}if(a==='refresh'){if(state.tab==='queue')await loadJobs();else if(state.tab==='notifications')await loadAnnouncements();else if(state.tab==='settings')await loadSettings();else if(state.selectedProject)await refreshProject();else await loadProjects();return}if(a==='more-queue'){state.queueRenderLimit=Math.min(Math.max(24,state.jobs.length),state.queueRenderLimit+24);updateQueueDom();return}if(a==='clear-temp'){try{window.NovelNative?.clearTemporaryData?.();toast('임시 캐시를 정리했습니다.')}catch(_){toast('임시 데이터 정리에 실패했습니다.')}return}if(a==='open-project'){await openProject(id);return}if(a==='toggle-project-desc'){if(state.expandedProjectDescriptions.has(id))state.expandedProjectDescriptions.delete(id);else state.expandedProjectDescriptions.add(id);render();return}if(a==='project-tab'){state.projectTab=id;render();return}if(a==='chapter-filter'){state.chapterFilter=id;render();return}if(a==='select-chapter'){if(el.checked)state.selectedChapterIds.add(id);else state.selectedChapterIds.delete(id);render();return}if(a==='clear-selection'){state.selectedChapterIds.clear();render();return}if(a==='create-project'){state.sheet={type:'create-project'};render();return}if(a==='import-project-file'){state.fileImportMode='project';fileImport.multiple=true;fileImport.value='';fileImport.click();return}if(a==='create-chapter'){state.sheet={type:'chapter',chapter:{}};render();return}if(a==='edit-chapter'){try{const c=await request(`/api/chapters/${id}`);state.sheet={type:'chapter',id,chapter:c};render()}catch(err){toast(err.message)}return}if(a==='open-manuscript'){await openManuscript(id);return}if(a==='edit-current-chapter'){const c=state.selectedChapter;if(!c)return;state.sheet={type:'chapter',id:c.id,chapter:c};render();return}if(a==='import-file'){state.fileImportMode='chapter';fileImport.multiple=false;fileImport.value='';fileImport.click();return}if(a==='chapter-more'){const c=state.chapters.find(x=>x.id===id);state.sheet={type:'chapter-more',chapter:c};render();return}if(a==='open-report'){await openReport(id);return}if(a==='revision-history'){await openRevisionHistory();return}if(a==='memo-filter'){state.memoFilter=id||'all';render();setTimeout(()=>document.getElementById('report-editor-memo')?.scrollIntoView({block:'start'}),30);return}if(a==='director-point'){askDirectorPoint(el.dataset.index,el.dataset.ref||'');return}if(a==='editorial-exclusion'){await toggleEditorialExclusion(el.dataset.index,el.dataset.ref||'',el.dataset.rule||'');return}if(a==='editorial-restore'){await toggleEditorialExclusion(-1,'',el.dataset.rule||'');return}if(a==='revision-toggle'){const s=state.sheet;if(s?.type!=='revision-history')return;const k=decodeURIComponent(el.dataset.key||'');s.selected=s.selected.includes(k)?s.selected.filter(x=>x!==k):(s.selected.length>=2?[s.selected[0],k]:[...s.selected,k]);render();return}if(a==='revision-clear'){if(state.sheet?.type==='revision-history'){state.sheet.selected=[];render()}return}if(a==='revision-inspect'){await inspectRevision();return}if(a==='revision-back'){if(state.sheet?.type==='revision-detail'){state.sheet=state.sheet.returnTo;render()}return}if(a==='close-report'){state.projectTab='chapters';state.selectedChapter=null;state.analysis=null;state.editorialExclusions=[];state.directorFocus=null;render();return}if(a==='report-tab'){state.reportTab=id;render();return}if(a==='open-comments'){state.readerCommentLimit=20;const returnSheet=state.sheet?.type==='manuscript'?{...state.sheet}:null;state.sheet={type:'comments',returnSheet};render();return}if(a==='more-reader-comments'){state.readerCommentLimit=Math.min(999,state.readerCommentLimit+20);render();return}if(a==='analyze-one'){const c=state.chapters.find(x=>x.id===id)||state.selectedChapter;await analyzeChapter(c);return}if(a==='analyze-selected'){await analyzeSelected();return}if(a==='toggle-average'){await toggleAverage([...state.selectedChapterIds],val==='exclude');return}if(a==='toggle-one-average'){await toggleAverage([id],val==='exclude');state.sheet=null;return}if(a==='bulk-duplicate'){await bulkDuplicate();return}if(a==='bulk-delete'){await bulkDelete();return}if(a==='duplicate-chapter'){await duplicateChapter(id);state.sheet=null;return}if(a==='delete-chapter'){await deleteChapter(id);state.sheet=null;return}if(a==='reset-chapter'){await resetChapter(id);state.sheet=null;return}if(a==='character-toggle'){await excludeCharacter(el.dataset.name,val==='exclude');return}if(a==='edit-memory'){const item=arr(state.memory?.elements).find(x=>x.id===id);if(item){state.sheet={type:'memory-edit',element:item};render()}return}if(a==='memory-status'){await patchMemoryElement(id,val);return}if(a==='recommend-titles'){await recommendTitles();return}if(a==='duplicate-project'){await duplicateProject();return}if(a==='delete-project'){await deleteProject();return}if(a==='reset-project'){await resetProject();return}if(a==='trash'){await loadTrash();return}if(a==='restore-trash'){await restoreTrash(id);return}if(a==='purge-trash'){await purgeTrash(id);return}if(a==='empty-trash'){await emptyTrash();return}if(a==='cancel-job'){await cancelJob(id);return}if(a==='cancel-all'){await cancelAll();return}if(a==='notice-tab'){state.noticeTab=id;if(id==='announcements')await loadAnnouncements(false);render();return}if(a==='announcement'){await readAnnouncement(id);return}if(a==='theme'){state.theme=id;localStorage.setItem(LS.theme,id);applyAppearance();render();return}if(a==='score-display'){await saveDisplayPreference(id);return}if(a==='toggle-native'){state.nativeNotices=!state.nativeNotices;localStorage.setItem(LS.native,state.nativeNotices?'1':'0');if(state.nativeNotices)try{window.NovelNative?.requestNotifications?.()}catch(_){}setTimeout(()=>{refreshNativePermission();render()},450);render();return}if(a==='notification-settings'){try{window.NovelNative?.openAppSettings?.()}catch(_){}return}if(a==='remove-key'){await removeKey(id);return}if(a==='test-ai'){await testAI();return}if(a==='logout'){await logout();return}if(a==='external'){openExternal(path);return}if(a==='close-sheet'){if(state.sheet?.type==='comments'&&state.sheet.returnSheet)state.sheet=state.sheet.returnSheet;else state.sheet=null;render();return}if(a==='evidence'){if(state.selectedChapter?.id)await openManuscript(state.selectedChapter.id,id,el.dataset.claim||'');return}}
 
 fileImport.addEventListener('change',async()=>{const files=[...(fileImport.files||[])];if(!files.length)return;try{if(state.fileImportMode==='project'){const loaded=[];for(const f of files.sort((a,b)=>a.name.localeCompare(b.name,'ko',{numeric:true}))){loaded.push({name:f.name,text:await f.text()})}state.pendingImportFiles=loaded;state.sheet={type:'project-import'};fileImport.multiple=false;render();return}const f=files[0],text=await f.text(),area=document.getElementById('chapter-content');if(area){area.value=text;updateChapterCountPreview(text);toast(`${f.name}을 원고에 불러왔습니다.`)}}catch{toast('파일을 읽지 못했습니다.')}finally{state.fileImportMode='chapter'}});
 boot();
