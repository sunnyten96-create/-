 /* 0.6.0 · Web 9.3.1 editorial-point controls */
 .editorial-point-actions{display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px;margin-top:10px;padding-top:9px;border-top:1px solid var(--hairline)}.editorial-point-actions button{min-height:36px;border-radius:11px;padding:7px 9px;font-size:.53rem;font-weight:900;display:flex;align-items:center;justify-content:center;gap:5px}.point-question{background:var(--surface);border:1px solid var(--line);color:var(--blue)}.point-question .icon-svg{width:13px;height:13px}.point-exclusion{background:var(--surface-2);color:var(--muted);border:1px solid transparent}.point-exclusion.on{background:var(--amber-soft);color:#8a6514;border-color:color-mix(in srgb,var(--amber) 34%,var(--line))}.check-box{width:16px;height:16px;border-radius:5px;border:1px solid currentColor;display:grid;place-items:center;font-size:.48rem;flex:0 0 auto}.suggestion-detail.editorial-muted{border-color:color-mix(in srgb,var(--amber) 35%,var(--line))}.editorial-exclusion-panel{margin-top:12px;border:1px solid var(--line);border-radius:14px;padding:10px;background:var(--surface-2)}.editorial-exclusion-panel summary{font-size:.6rem;font-weight:900}.editorial-exclusion-note{font-size:.52rem;line-height:1.55;color:var(--muted);padding:8px 0}.excluded-rule{display:flex;gap:8px;align-items:flex-start;justify-content:space-between;border-top:1px solid var(--hairline);padding:8px 0}.excluded-rule span{font-size:.56rem;line-height:1.45}.excluded-rule button{flex:0 0 auto;border:1px solid var(--line);border-radius:8px;padding:5px 7px;background:var(--surface);font-size:.5rem;font-weight:900;color:var(--muted)}.director-context .focus-point{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:var(--amber-soft);color:#8a6514}
 @media(max-width:390px){.editorial-point-actions{grid-template-columns:1fr}.point-exclusion{justify-content:flex-start}}
